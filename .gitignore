*.docx

# Local media / reference material - not tracked in repo
*.png
# ...except the footer's donation icon, which the app imports.
!/platform/donate_icon.png
*.webm
*.mp4
Website-цена.txt
platform/Videos/
platform/KUKO_WAY_Legal_Documents/
# Private client chat screenshots (requirements input, personal data).
Client-chat-requirements/

# Local exports (e.g. Stripe test invoice/receipt PDFs) inside the dated
# daily working folders at the repo root (dd.mm.yyyy/). PDFs elsewhere stay
# trackable.
/[0-9][0-9].[0-9][0-9].[0-9][0-9][0-9][0-9]/**/*.pdf

# Local notes holding live credentials (SMTP key, demo password). Never commit.
/08.10.2026/сеттингс.txt

# Python bytecode caches (qr-artwork scripts).
__pycache__/
*.pyc

# QR artwork: console logs of the superseded iterations' verification runs
# (regenerable by the verify_*.py scripts). Markdown reports stay trackable.
/qr-artwork/out/*-verification.txt
