# =============================================================================
# Community Platform — environment configuration template
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# This application is fully independent and has no connection to, and does
# not read from or write to, app.humangarage.net or any of its systems.
# =============================================================================

# --- Application -------------------------------------------------------------
APP_NAME="Community Platform"
APP_URL="http://localhost:3000"
NODE_ENV="development"

# --- Database (PostgreSQL) ----------------------------------------------------
# Local dev example: postgresql://postgres:postgres@localhost:5432/community_platform
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/community_platform"

# --- Authentication (NextAuth.js) --------------------------------------------
# Generate with: `openssl rand -base64 32`
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# --- Defaults (used to seed the Settings table on first run) -----------------
DEFAULT_LANGUAGE="en"
DEFAULT_CURRENCY="EUR"

# --- Billing / Payments (Stripe — TEST MODE ONLY at this stage) --------------
# Foundation only: no real charges are processed by this codebase yet.
# Get test keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_replace_me"
STRIPE_PUBLISHABLE_KEY="pk_test_replace_me"
# From the Stripe CLI (`stripe listen`) or a configured test webhook endpoint.
STRIPE_WEBHOOK_SECRET="whsec_replace_me"

# --- Media storage (foundation only; local storage by default) --------------
# When ready to connect real object storage, populate these and switch the
# provider in modules/media/storage.ts. Leaving them empty keeps local
# filesystem storage under /public/uploads for development.
STORAGE_PROVIDER="local"
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
