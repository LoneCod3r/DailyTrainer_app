# =============================================================================
# Community Platform — environment configuration template
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# This application is fully independent and has no connection to, and does
# not read from or write to, app.humangarage.net or any of its systems.
# =============================================================================

# --- Application -------------------------------------------------------------
APP_NAME="KUKO WAY"
APP_URL="http://localhost:3000"
NODE_ENV="development"

# --- Database (PostgreSQL) ----------------------------------------------------
# Local dev example: postgresql://postgres:postgres@localhost:5432/community_platform
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/community_platform"

# --- Authentication (NextAuth.js) --------------------------------------------
# Generate with: `openssl rand -base64 32`
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# --- Defaults (used to seed the Settings table on first run) -----------------
DEFAULT_LANGUAGE="en"
DEFAULT_CURRENCY="EUR"

# --- Billing / Payments (Stripe — TEST MODE ONLY at this stage) --------------
# Foundation only: no real charges are processed by this codebase yet.
# Get test keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_replace_me"
STRIPE_PUBLISHABLE_KEY="pk_test_replace_me"
# From the Stripe CLI (`stripe listen`) or a configured test webhook endpoint.
STRIPE_WEBHOOK_SECRET="whsec_replace_me"

# --- Bot protection (Google reCAPTCHA v3) ------------------------------------
# Register a v3 site at https://www.google.com/recaptcha/admin and put its
# keys here. Unlike some CAPTCHA providers, Google does not publish a
# universal "always passes" test key pair that works on an unregistered
# domain, so these are left empty for local dev — with RECAPTCHA_SECRET_KEY
# unset, the app skips real verification outside production only (see
# lib/recaptcha.ts). Both MUST be set in production or the CAPTCHA becomes a
# no-op.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""

# --- Outbound email (verification / password reset) --------------------------
# Any standard SMTP provider works — a production sender (Postmark, SES,
# Mailgun, Resend's SMTP endpoint, Gmail app password, ...) or a local-dev
# sandbox inbox (Mailtrap, Ethereal — https://ethereal.email, free, no signup
# needed) are configured through these same five variables; there's no
# separate "sandbox mode". With SMTP_HOST left empty, lib/mail.ts logs the
# email instead of sending it — that fallback only exists outside
# production: NODE_ENV=production with SMTP_HOST unset makes every
# verification/reset email attempt fail loudly (not silently) instead of
# pretending to have sent something it didn't. See docs/auth-security.md for
# exact Mailtrap/Ethereal setup steps.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="KUKO WAY <no-reply@example.dev>"

# --- Media storage (foundation only; local storage by default) --------------
# When ready to connect real object storage, populate these and switch the
# provider in modules/media/storage.ts. Leaving them empty keeps local
# filesystem storage under /public/uploads for development.
STORAGE_PROVIDER="local"
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
